<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/status_inactive"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/nextAlarmText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/next_alarm_none"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/tone_label"
        android:textSize="14sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/toneRadioGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp">

        <RadioButton
            android:id="@+id/toneDefault"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tone_default" />

        <RadioButton
            android:id="@+id/toneMyDarling"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tone_my_darling" />

        <RadioButton
            android:id="@+id/toneProtegeons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tone_protegeons" />
    </RadioGroup>

    <Button
        android:id="@+id/toggleButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="24dp"
        android:text="@string/action_enable_alarm" />

    <Button
        android:id="@+id/stopSoundButton"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:text="@string/action_stop_sound" />

</LinearLayout>
